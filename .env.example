# Скопируйте в .env в корне репозитория и подставьте свои значения.
#   Windows:  copy .env.example .env
#   bash:     cp .env.example .env
#
# Docker Compose подхватывает .env автоматически для подстановки ${VAR} в compose-файле.

# Порт на localhost: контейнер web (nginx + статика) слушает здесь.
HTTP_PORT=8080

# --- Локальная разработка без Docker (Vite dev server) ---
# В каталоге frontend создайте файл .env.development.local (он в .gitignore) и задайте API:
# VITE_API_BASE_URL=http://localhost:3001/api
